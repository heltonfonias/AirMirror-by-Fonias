<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
     
  <!-- AirMirror ships UxPlay in-process and has its own upgrade identity. -->
  <Package
    Id="AirMirrorByFonias"
    Name="AirMirror by Fonias"
    Manufacturer="Fonias"
    Version="1.0.0"
    UpgradeCode="edad2f99-352d-46ee-8b93-88c9c1c34d62"
    Language="1033"
    Scope="perMachine">

    <MajorUpgrade
      DowngradeErrorMessage="A newer version of AirMirror is already installed." />
    <WixVariable Id="WixUILicenseRtf" Value="./docs/LICENSE.rtf" />
    <WixVariable Id="WixUIBannerBmp" Value="./stuff/AirMirror-banner.bmp" />
    <WixVariable Id="WixUIDialogBmp" Value="./stuff/AirMirror-dialog.bmp" />
    <Icon Id="AirMirrorIcon" SourceFile="./stuff/AirMirror.ico" />
    <Property Id="ARPPRODUCTICON" Value="AirMirrorIcon" />
    <MediaTemplate EmbedCab="yes" />

    <ui:WixUI Id="WixUI_FeatureTree" />

    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="INSTALLDIR" Name="AirMirror by Fonias" />
    </StandardDirectory>

    <Feature Id="MainFeature" Title="AirMirror by Fonias" Level="1">
      <ComponentGroupRef Id="AppFiles" />
      <ComponentGroupRef Id="AppExe" />
      <ComponentRef Id="ProgramMenuShortcutComponent" />
    </Feature>

    <Feature
      Id="DesktopShortcuts"
      Title="Desktop Shortcut"
      Description="Create a shortcut on the desktop"
      Level="1">
      <ComponentRef Id="DesktopShortcutComponent" />
    </Feature>

    <ComponentGroup Id="AppFiles" Directory="INSTALLDIR">
      <Files Include="./release/**">
        <Exclude Files="./release/AirMirror.exe;**/*.pdb;**/AirMirror.exe" />
      </Files>
    </ComponentGroup>

    <ComponentGroup Id="AppExe" Directory="INSTALLDIR">
      <Component Id="AppExeComponent"
                 Guid="75fd98d2-ee1c-4649-ba6b-d5b0a65542cb">
        <File Id="AppExeFile"
              Source="./release/AirMirror.exe"
              KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <StandardDirectory Id="DesktopFolder" />
    <StandardDirectory Id="ProgramMenuFolder" />

    <Component Id="ProgramMenuShortcutComponent"
               Guid="eb0581df-bee5-45d4-9328-4117d44ae6af"
               Directory="ProgramMenuFolder">
      <RegistryValue
        Root="HKCU"
        Key="Software\Fonias\AirMirror"
        Name="ProgramMenuShortcut"
        Type="integer"
        Value="1"
        KeyPath="yes" />
      <Shortcut
        Name="AirMirror by Fonias"
        Directory="ProgramMenuFolder"
        Target="[INSTALLDIR]AirMirror.exe"
        WorkingDirectory="INSTALLDIR"
        Advertise="no" />
    </Component>

    <Component Id="DesktopShortcutComponent"
               Guid="de016600-63b9-40fc-a9be-4f2d63fce58f"
               Directory="DesktopFolder">
      <RegistryValue
        Root="HKCU"
        Key="Software\Fonias\AirMirror"
        Name="DesktopShortcut"
        Type="integer"
        Value="1"
        KeyPath="yes" />
      <Shortcut
        Name="AirMirror by Fonias"
        Directory="DesktopFolder"
        Target="[INSTALLDIR]AirMirror.exe"
        WorkingDirectory="INSTALLDIR"
        Advertise="no" />
    </Component>

  </Package>
</Wix>
